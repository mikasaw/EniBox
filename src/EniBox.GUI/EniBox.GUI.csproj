<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType Condition="'$(CLI_MODE)' == 'true'">Exe</OutputType>
    <OutputType Condition="'$(CLI_MODE)' != 'true'">WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF Condition="'$(CLI_MODE)' != 'true'">true</UseWPF>
    <UseWPF Condition="'$(CLI_MODE)' == 'true'">false</UseWPF>
    <UseWindowsForms Condition="'$(CLI_MODE)' != 'true'">true</UseWindowsForms>
    <UseWindowsForms Condition="'$(CLI_MODE)' == 'true'">false</UseWindowsForms>
    <RootNamespace>EniBox.GUI</RootNamespace>
    <AssemblyName Condition="'$(CLI_MODE)' != 'true'">EniBox</AssemblyName>
    <AssemblyName Condition="'$(CLI_MODE)' == 'true'">EniBox.CLI</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <DefineConstants Condition="'$(CLI_MODE)' == 'true'">$(DefineConstants);CLI_MODE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="LZMA-SDK" Version="22.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\EniBox.PeTool\x64\Release\EniBox.PeTool.dll" Link="EniBox.PeTool.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\EniBox.Loader\x64\Release\EniBox.Loader.dll" Link="Resources\EniBox.Loader.x64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\EniBox.Loader\x64\Release\EniBox.Loader.dll" LogicalName="EniBox.Loader.x64.dll" Condition="Exists('..\EniBox.Loader\x64\Release\EniBox.Loader.dll')" />
    <EmbeddedResource Include="..\EniBox.Loader\Release\EniBox.Loader.dll" LogicalName="EniBox.Loader.x86.dll" Condition="Exists('..\EniBox.Loader\Release\EniBox.Loader.dll')" />
  </ItemGroup>

  <!-- Exclude GUI-specific files in CLI mode -->
  <ItemGroup Condition="'$(CLI_MODE)' == 'true'">
    <Compile Remove="App.xaml.cs" />
    <Compile Remove="Views\MainWindow.xaml.cs" />
    <Compile Remove="ViewModels\MainViewModel.cs" />
    <Page Remove="Views\MainWindow.xaml" />
    <Page Remove="App.xaml" />
    <None Remove="Resources\*.xaml" />
  </ItemGroup>

</Project>
